<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_igtf" model="ir.ui.view">
        <field name="name">account.payment.form.igtf</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="IGTF" invisible="not l10n_ve_igtf_available">
                    <field name="l10n_ve_igtf_available" invisible="1"/>
                    <field name="l10n_ve_igtf_apply" readonly="state != 'draft'"/>
                    <field name="l10n_ve_igtf_rate" readonly="state != 'draft'" invisible="not l10n_ve_igtf_apply"/>
                    <field name="l10n_ve_igtf_amount" invisible="not l10n_ve_igtf_apply"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
