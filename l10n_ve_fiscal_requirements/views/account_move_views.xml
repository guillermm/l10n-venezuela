<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_ve" model="ir.ui.view">
        <field name="name">account.move.form.inherit.ve</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="nro_ctrl" invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"/>
                <field name="supplier_invoice_number" invisible="move_type not in ('in_invoice', 'in_refund')"/>
                <field name="date_document" invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"/>
                <field name="sin_cred" invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Fiscal Printer Info" invisible="move_type not in ('out_invoice', 'in_invoice', 'out_refund', 'in_refund')">
                    <field name="invoice_printer"/>
                    <field name="fiscal_printer"/>
                    <field name="z_report"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
