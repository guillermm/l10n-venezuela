<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_ve_responsibility_type_tree" model="ir.ui.view">
        <field name="name">l10n_ve.responsibility.type.tree</field>
        <field name="model">l10n_ve.responsibility.type</field>
        <field name="arch" type="xml">
            <tree string="SENIAT Taxpayer Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_l10n_ve_responsibility_type_form" model="ir.ui.view">
        <field name="name">l10n_ve.responsibility.type.form</field>
        <field name="model">l10n_ve.responsibility.type</field>
        <field name="arch" type="xml">
            <form string="SENIAT Taxpayer Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ve_responsibility_type" model="ir.actions.act_window">
        <field name="name">SENIAT Taxpayer Types</field>
        <field name="res_model">l10n_ve.responsibility.type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
