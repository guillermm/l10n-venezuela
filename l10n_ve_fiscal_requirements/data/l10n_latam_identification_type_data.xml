<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Screenshot_34: RIF VE, Cédula Venezolano VE, Cédula Extranjera, Pasaporte. -->
    <record id="it_rif" model="l10n_latam.identification.type">
        <field name="name">RIF</field>
        <field name="sequence">10</field>
        <field name="is_vat" eval="True"/>
        <field name="country_id" ref="base.ve"/>
        <field name="active" eval="True"/>
    </record>
    <record id="it_cedula_v" model="l10n_latam.identification.type">
        <field name="name">Cédula Venezolano</field>
        <field name="sequence">20</field>
        <field name="country_id" ref="base.ve"/>
        <field name="active" eval="True"/>
    </record>
    <record id="it_cedula_e" model="l10n_latam.identification.type">
        <field name="name">Cédula Extranjera</field>
        <field name="sequence">30</field>
        <field name="active" eval="True"/>
    </record>
    <record id="it_pass" model="l10n_latam.identification.type">
        <field name="name">Pasaporte</field>
        <field name="sequence">40</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
