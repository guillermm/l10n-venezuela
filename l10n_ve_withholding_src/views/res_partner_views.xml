<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_wh_src" model="ir.ui.view">
        <field name="name">res.partner.form.wh.src</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group name="l10n_ve_src" string="SRC Withholding">
                    <field name="wh_src_subject"/>
                    <field name="wh_src_rate" invisible="not wh_src_subject"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
