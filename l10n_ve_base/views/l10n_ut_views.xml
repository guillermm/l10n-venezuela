<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_ut_tree" model="ir.ui.view">
        <field name="name">l10n.ut.tree</field>
        <field name="model">l10n.ut</field>
        <field name="arch" type="xml">
            <list string="Tax Units">
                <field name="date" />
                <field name="name" />
                <field name="amount" />
                <field name="user_id" />
            </list>
        </field>
    </record>

    <record id="view_l10n_ut_form" model="ir.ui.view">
        <field name="name">l10n.ut.form</field>
        <field name="model">l10n.ut</field>
        <field name="arch" type="xml">
            <form string="Tax Unit">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="date" />
                        </group>
                        <group>
                            <field name="amount" />
                            <field name="user_id" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_ut" model="ir.actions.act_window">
        <field name="name">Tax Units (UT)</field>
        <field name="res_model">l10n.ut</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
