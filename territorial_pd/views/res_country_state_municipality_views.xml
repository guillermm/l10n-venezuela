<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_country_state_municipality_tree" model="ir.ui.view">
        <field name="name">res.country.state.municipality.tree</field>
        <field name="model">res.country.state.municipality</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="state_id"/>
            </tree>
        </field>
    </record>

    <record id="view_res_country_state_municipality_form" model="ir.ui.view">
        <field name="name">res.country.state.municipality.form</field>
        <field name="model">res.country.state.municipality</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="state_id"/>
                    </group>
                    <field name="parish_ids">
                        <tree editable="bottom">
                            <field name="code"/>
                            <field name="name"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_res_country_state_municipality" model="ir.actions.act_window">
        <field name="name">Municipalities</field>
        <field name="res_model">res.country.state.municipality</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_res_country_state_municipality"
              name="Municipalities"
              parent="contacts.menu_localisation"
              action="action_res_country_state_municipality"
              sequence="5"/>
</odoo>
