<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_wh_muni" model="ir.ui.view">
        <field name="name">res.partner.form.wh.muni</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group name="l10n_ve_muni" string="Municipal Withholding">
                    <field name="state_id" invisible="1"/>
                    <field name="municipality_id"
                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                           domain="['|', ('state_id', '=', state_id), ('state_id.country_id.code', '=', 'VE')]"/>
                    <field name="muni_activity_id"
                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                           domain="['|', ('municipality_id', '=', municipality_id), ('municipality_id', '=', False)]"
                           context="{'tree_view_ref': 'l10n_ve_withholding_muni.view_l10n_ve_muni_activity_tree', 'search_view_ref': 'l10n_ve_withholding_muni.view_l10n_ve_muni_activity_search'}"/>
                    <field name="wh_muni_rate"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
