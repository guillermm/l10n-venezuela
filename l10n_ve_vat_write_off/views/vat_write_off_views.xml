<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vat_write_off_tree" model="ir.ui.view">
        <field name="name">vat.write.off.tree</field>
        <field name="model">vat.write.off</field>
        <field name="arch" type="xml">
            <tree string="VAT Write Offs">
                <field name="name"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_vat_write_off_form" model="ir.ui.view">
        <field name="name">vat.write.off.form</field>
        <field name="model">vat.write.off</field>
        <field name="arch" type="xml">
            <form string="VAT Write Off">
                <header>
                    <button name="action_post" type="object" string="Post" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancel'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                            <field name="journal_id"/>
                            <field name="debit_account_id"/>
                            <field name="credit_account_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="purchase_book_id"/>
                            <field name="sale_book_id"/>
                            <field name="move_id" readonly="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vat_write_off" model="ir.actions.act_window">
        <field name="name">VAT Write Offs</field>
        <field name="res_model">vat.write.off</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
